MONGO_ROOT_USERNAME=examai
MONGO_ROOT_PASSWORD=examai
MONGO_DATABASE=exam-ai

# Server
SERVER_PORT=5000
SERVER_JWT_SECRET=change-this-secret
SERVER_CLIENT_URL=http://localhost:5173
SERVER_AI_SERVICE_URL=http://localhost:8000
SERVER_UPLOAD_DIR=../data/raw
SERVER_MAX_UPLOAD_SIZE_MB=15

# AI Service
AI_SERVICE_PORT=8000
AI_LLM_PROVIDER=huggingface
AI_LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1/chat/completions
AI_LM_STUDIO_MODEL=mistral-7b-instruct
AI_HUGGINGFACE_API_KEY=
AI_HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
AI_HUGGINGFACE_API_URL=https://api-inference.huggingface.co/models
AI_SENTENCE_MODEL=all-MiniLM-L6-v2
AI_DOCUMENT_AI_ENABLED=true
AI_DOCUMENT_AI_MODEL=naver-clova-ix/donut-base-finetuned-docvqa
AI_DOCUMENT_AI_PROMPT="<s_docvqa><s_question>What text is written in this exam document?</s_question><s_answer>"
AI_DOCUMENT_AI_MAX_PAGES=3
AI_DOCUMENT_AI_MAX_LENGTH=768

# Client
CLIENT_PORT=5173
CLIENT_API_BASE_URL=http://localhost:5000/api
